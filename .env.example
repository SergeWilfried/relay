# Privy app ID (https://dashboard.privy.io). Leave empty to run in demo mode (no sign-in, placeholder wallets).
VITE_PRIVY_APP_ID=
# Optional: your API base URL (defaults to /api)
VITE_API_URL=
# Optional: RPC endpoints for wallet balance reads (defaults are free public endpoints; use your own keys in production)
VITE_ETH_RPC_URL=
VITE_SOL_RPC_URL=
