{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "relay",
    // Set this to today's date
    "compatibility_date": "2026-10-02",
    "main": "./worker/index.ts",
    "assets": {
      "not_found_handling": "single-page-application",
      "run_worker_first": [
        "/api/*"
      ]
    },
            "observability": {
          "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
          },
          "traces": {
            "enabled": true,
            "head_sampling_rate": 1,
            "persist": true
          },
          "issue_detection": {
            "enabled": true
          }
        },
        "vars": {
            "LIVE": "true",
            "PAYOUT_PROVIDER": "sandbox", // "pawapay" pays through pawaPay (needs the PAWAPAY_API_TOKEN secret)
            // pawaPay API base: https://api.sandbox.pawapay.io (no money moves) or https://api.pawapay.io (production: only with LIVE=true)
            "PAWAPAY_BASE_URL": "https://api.sandbox.pawapay.io",
            // Privy REST API base for the swap client (override only to test against a mock)
            "PRIVY_API_URL": "https://api.privy.io",
            // JSON-RPC endpoint used to fetch a blockhash for Solana sweeps (empty = the public mainnet-beta endpoint, which is rate-limited: use a provider URL in production)
            "SOLANA_RPC_URL": "",
            // "true" turns Clef on (alert triage C-05 and the daily review C-04). Both start in shadow mode: see README.
            "CLEF_ENABLED": "true"
        },
        // KV: webhook idempotency (processed event ids) + a small user/wallet index.
        // `vite dev`/`wrangler dev` provision it locally; for production let `wrangler deploy` provision it
        // or run `npx wrangler kv namespace create relay-events` and add the id here.
        "triggers": { "crons": ["*/5 * * * *", "0 3 * * *"] }, // every 5 min: sweeps (worker/sweep.ts); daily 03:00 UTC: Clef activity review (worker/clefBatch.ts)
        // Workers AI, for Clef (@cf/cloudflare/clef). Calls are billed per token; they only happen when CLEF_ENABLED is "true".
        "ai": { "binding": "AI" },
        "kv_namespaces": [{ "binding": "EVENTS" }],
        // D1: server-side sell orders (see migrations/). Local: `pnpm db:migrate:local`. Production: `pnpm db:migrate`.
        "d1_databases": [{ "binding": "DB", "database_name": "relay", "migrations_dir": "migrations" }]
        // Secrets (never put these in this file): wrangler secret put PRIVY_WEBHOOK_SIGNING_SECRET | PRIVY_VERIFICATION_KEY | PRIVY_APP_ID | PRIVY_APP_SECRET
        // LIVE="true" makes new sell orders create real Privy deposit wallets (needs PRIVY_APP_SECRET); "false" uses placeholder addresses.
        // Local: copy .dev.vars.example to .dev.vars
    }